#!/usr/bin/env bash

[[ -f ~/.bash_profile ]] && rm ~/.bash_profile
[[ -f ~/.jbw/bash/dot-bash_profile ]] && cp ~/.jbw/bash/dot-bash_profile ~/.bash_profile
[[ -f ~/.bashrc ]] && rm ~/.bashrc
[[ -f ~/.jbw/bash/dot-bashrc ]] && cp ~/.jbw/bash/dot-bashrc ~/.bashrc
[[ -d ~/.config/bashrc ]] && rm -rf ~/.config/bashrc
[[ -d ~/.jbw/bash/dot-config ]] && cp -r ~/.jbw/bash/dot-config/bashrc ~/.config/
