#!/usr/bin/env bash

echo
echo "Setting up graphics drivers"
echo
echo "Are you using an Nvidia or AMD card?"
echo
echo "*[1] Nvidia"
echo " [2] AMD"
echo
read -rp 'The default is marked (*). Return to continue or enter a selection: ' graphics
case $graphics in
  2)
    sudo pacman -S --needed xf86-video-amdgpu mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon
    sudo pacman -S --needed libva-mesa-driver lib32-libva-mesa-driver mesa-vdpau lib32-mesa-vdpau
    ;;
  *)
    sudo pacman -S --needed nvidia-open-dkms nvidia-utils lib32-nvidia-utils libva-nvidia-driver libvdpau nvidia-settings
    ;;
esac

sudo pacman -S --needed libva-utils vdpauinfo
