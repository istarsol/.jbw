#!/usr/bin/env bash

echo
echo "Installing packages common for arch"
echo

sudo pacman -S --needed \
  base \
  base-devel \
  bash-completion \
  intel-ucode \
  linux \
  linux-headers \
  man-db \
  nano \
  neovim \
  openssh \
  rsync \
  util-linux \
  vi \
  vim

echo
echo "Installing common fonts"
echo

sudo pacman -S --needed \
  terminus-font \
  noto-fonts-extra
