#!/usr/bin/env bash

echo
echo "Install some basic workstation packages"
echo

sudo pacman -S --needed \
  ark \
  brave-bin \
  cups \
  firefox \
  ghostty \
  github-cli \
  jre-openjdk \
  libreoffice-fresh \
  obsidian \
  partitionmanager \
  syncthing

systemctl --user enable --now syncthing
