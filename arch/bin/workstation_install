#!/usr/bin/env bash

echo
echo "Install some basic workstation packages"
echo

sudo pacman -S --needed \
  ark \
  brave-bin \
  cups \
  firefox \
  ghostty \
  github-cli \
  jre-openjdk \
  libreoffice-fresh \
  obsidian \
  partitionmanager \
  syncthing

systemctl --user enable --now syncthing
sudo systemctl enable avahi-daemon

echo
echo "Install pandoc and pip"
echo

sudo pacman -S --needed \
  pandoc-cli \
  python-pip \
  python-pipx

pipx install pandoc-include


echo
echo "Install Kdenlive"
echo

sudo pacman -S --needed \
  kdenlive \
  kimageformats \
  qt6-imageformats

echo
echo "Install PDF tools"
echo

sudo pacman -S --needed \
  evince \
  okular \
  pdfarranger \
  xournalpp

echo
echo "Install scanning tools"
echo

sudo pacman -S --needed \
  sane \
  simple-scan \
  skanlite \
  skanpage

echo
echo "Install VSCodium"
echo

paru -S --needed vscodium-bin vscodium-bin-marketplace

echo
echo "Install VLC"
echo

sudo pacman -S --needed \
  vlc \
  vlc-plugins-all

echo
echo "Install gaming tools"
echo

sudo pacman -S --needed \
  cachyos-gaming-applications \
  cachyos-gaming-meta \
  gamemode \
  lib32-gamemode \
  protonup-qt

systemctl --user enable --now gamemoded

sudo bash -c "echo -e 'vm.max_map_count = 2147483642' > /etc/sysctl.d/80-gamecompatibility.conf"
